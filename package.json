{
  "name": "nabby",
  "version": "0.2.4",
  "description": "Discord bot for the server Operation Aziris.",
  "main": "build/index.js",
  "scripts": {
    "core-set": "node scripts/core-set.js",
    "core-run": "node scripts/core-run.js",
    "deploy-dev": "tsx --env-file=data/.env.dev src/deploy-commands.ts",
    "deploy-prod": "tsx --env-file=data/.env.prod src/deploy-commands.ts",
    "clean": "node scripts/clean.js",
    "build": "tsc",
    "clean-build": "node scripts/clean.js && tsc",
    "dev": "tsx watch --env-file=data/.env.dev src/index.ts",
    "prod": "node --env-file=data/.env.prod .",
    "lint": "eslint . --fix"
  },
  "keywords": [],
  "author": "VoidThreader",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "hjson": "^3.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hjson": "^2.4.6",
    "@types/node": "^22.20.2",
    "eslint": "^10.6.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "undici": "^6.26.1"
  }
}
